APP_NAME="Glass Ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Storage timezone stays UTC. Do NOT set to LA (it would store local wall-clock).
APP_TIMEZONE=UTC
# Operator-facing display + send-scheduling timezone.
APP_DISPLAY_TIMEZONE=America/Los_Angeles

# Outbound SMS provider: 'log' (default everywhere) or 'openphone' (production only).
MESSAGE_PROVIDER=log
# Google Ads insights provider for the ROAS dashboard: 'null' (default everywhere)
# or 'google_ads' (production only). Credentials live in Admin > Integrations.
ADS_PROVIDER=null
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# On Cloudways set QUEUE_CONNECTION=redis (see README).

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 in production (Cloudways). MariaDB locally. Keep Eloquent DB-agnostic.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=glass_dashboard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
